---
const awards = [
  {
    year: "2024",
    title: "Cup of Excellence Costa Rica",
    category: "Presidential Award - 1st Place Micro-Lot",
    notes: "Anaerobic Fermented Geisha • 92.8 SCA Score",
    icon: "🏆"
  },
  {
    year: "2023",
    title: "National Specialty Coffee Championship",
    category: "Best Single Origin Espresso",
    notes: "Turrialba Volcanic Honey Natural Process",
    icon: "🥇"
  },
  {
    year: "2022",
    title: "World Barista Guild Choice",
    category: "Top Sustainable Highland Terroir",
    notes: "Zero-Water Bio-Fermentation Process",
    icon: "🌟"
  },
  {
    year: "2021",
    title: "Central American Coffee Excellence",
    category: "Grand Gold Medal",
    notes: "Red Bourbon Micro-lot",
    icon: "🎖️"
  }
];
---

<section id="awards" class="py-24 bg-[#110e0b] relative border-y border-[#d4af37]/15">
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs uppercase tracking-[0.3em] text-[#c5a059] font-medium block mb-3">
        Recognized Nationally & Globally
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl text-white font-bold tracking-tight mb-6">
        Award-Winning <span class="gold-gradient-text italic font-normal">Mastery</span>
      </h2>
      <p class="text-gray-400 text-sm sm:text-base font-light leading-relaxed">
        Our obsessive pursuit of coffee perfection in Turrialba's unique volcanic terroir has garnered highest honors in national and international specialty coffee cupping competitions.
      </p>
    </div>

    <!-- Awards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {awards.map((award) => (
        <div class="award-card glass-card p-8 rounded-sm hover:border-[#d4af37]/60 transition-all duration-500 group flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-serif text-2xl text-[#d4af37] font-bold tracking-widest">{award.year}</span>
              <span class="text-3xl filter drop-shadow-[0_0_10px_rgba(212,175,55,0.4)] group-hover:scale-110 transition-transform">{award.icon}</span>
            </div>
            <h3 class="font-serif text-xl text-white font-semibold mb-2 group-hover:text-[#f3e5ab] transition-colors">
              {award.title}
            </h3>
            <p class="text-xs font-semibold uppercase tracking-wider text-[#c5a059] mb-4">
              {award.category}
            </p>
          </div>
          <div class="pt-4 border-t border-white/5 text-xs text-gray-400 italic">
            {award.notes}
          </div>
        </div>
      ))}
    </div>

    <!-- Recognition Quote -->
    <div class="mt-16 p-8 rounded-sm bg-[#15120e] border border-[#d4af37]/20 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full border border-[#d4af37] flex items-center justify-center shrink-0 text-[#d4af37] font-serif text-2xl font-bold">
          "
        </div>
        <div>
          <p class="text-sm sm:text-base text-gray-200 italic font-serif">
            "Coffee Secret Turrialba represents the pinnacle of Costa Rican volcanic specialty coffee: incredible jasmine aromas, crisp green apple acidity, and a velvet dark chocolate finish."
          </p>
          <span class="text-xs uppercase tracking-widest text-[#c5a059] mt-1 block">
            — Specialty Coffee Association Judge Panel
          </span>
        </div>
      </div>
      <a
        href="#booking"
        class="shrink-0 text-xs tracking-[0.2em] uppercase font-bold text-[#d4af37] border-b border-[#d4af37] pb-1 hover:text-white hover:border-white transition-colors"
      >
        Taste Award-Winning Lots &rarr;
      </a>
    </div>

  </div>
</section>
