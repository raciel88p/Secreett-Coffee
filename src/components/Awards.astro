---
const accolades = [
  {
    score: "92.5 SCA",
    award: "Cup of Excellence Costa Rica",
    description: "Highest scoring anaerobic micro-lot in Turrialba region history."
  },
  {
    score: "Gold Medal",
    award: "Specialty Coffee Expo 2024",
    description: "Best Single Origin Filter Roast awarded by international sensory panel."
  },
  {
    score: "Featured",
    award: "Global Roasters Guild",
    description: "Recognized for sustainable high-altitude agroforestry & farm transparency."
  }
];
---

<section id="awards" class="py-24 bg-black text-white border-t border-white/10">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8">

    <!-- Centered Header in GoodBoyBob Text-Layout Centered Style -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-amber-400 font-bold block mb-3">
        Industry Accolades
      </span>
      <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight mb-6">
        AWARD-WINNING <span class="font-serif italic font-normal text-amber-300">EXCELLENCE</span>
      </h2>
      <p class="text-gray-300 font-sans text-base sm:text-lg font-light leading-relaxed max-w-2xl mx-auto">
        Validated by international Q-graders, world barista champions, and specialty coffee critics across the globe.
      </p>
    </div>

    <!-- Awards Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {accolades.map((acc) => (
        <div class="bg-[#0e0e0e] border border-white/10 p-8 sm:p-10 flex flex-col justify-between hover:border-amber-400/60 transition-colors">
          <div>
            <span class="text-3xl sm:text-4xl font-mono font-black text-amber-300 block mb-4">
              {acc.score}
            </span>
            <h3 class="text-2xl font-black uppercase tracking-tight mb-3">
              {acc.award}
            </h3>
            <p class="text-gray-400 text-sm font-light leading-relaxed font-sans">
              "{acc.description}"
            </p>
          </div>
          <div class="pt-6 border-t border-white/10 mt-8 font-mono text-[11px] text-gray-500 uppercase tracking-widest">
            Certified Specialty Origin
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
