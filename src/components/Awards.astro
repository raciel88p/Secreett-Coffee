---
---

<section id="awards" class="py-24 bg-stone-950 text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <!-- Centered Header -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-amber-400 font-bold block mb-3" data-i18n="awards_badge">
        DISTINCIONES Y PREMIOS NACIONALES
      </span>
      <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight mb-6">
        <span data-i18n="awards_title_1">RECONOCIMIENTO</span> <span class="font-serif italic font-normal text-amber-400" data-i18n="awards_title_2">MUNDIAL Y DE EXCELENCIA.</span>
      </h2>
      <p class="text-stone-300 font-sans text-base sm:text-lg font-light leading-relaxed max-w-2xl mx-auto" data-i18n="awards_desc">
        Nuestros micro-lotes son elaborados en las laderas minerales del Volcán Turrialba, cosechados a mano en su punto óptimo de madurez y perfeccionados a través de procesos de fermentación anaeróbica galardonados.
      </p>
    </div>

    <!-- Awards Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-stone-900 border border-amber-500/20 p-8 sm:p-10 flex flex-col justify-between hover:border-amber-400 transition-all duration-300 group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl sm:text-4xl font-mono font-bold text-amber-400">92.5 SCA</span>
            <span class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[10px] font-mono uppercase tracking-wider">CUP OF EXCELLENCE</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-amber-400 transition-colors" data-i18n="award1_title">
            CUP OF EXCELLENCE
          </h3>
          <p class="text-stone-400 text-sm font-light leading-relaxed font-sans" data-i18n="award1_desc">
            Premio Nacional de Costa Rica por Micro-Lote Geisha Anaeróbico de Alta Elevación.
          </p>
        </div>
        <div class="pt-6 border-t border-white/10 mt-8 font-mono text-[11px] text-stone-500 uppercase tracking-widest flex items-center justify-between">
          <span>MICRO-LOTE VERIFICADO</span>
          <span class="text-amber-400">★ ★ ★ ★ ★</span>
        </div>
      </div>

      <div class="bg-stone-900 border border-amber-500/20 p-8 sm:p-10 flex flex-col justify-between hover:border-amber-400 transition-all duration-300 group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl sm:text-4xl font-mono font-bold text-amber-400">TOP 1%</span>
            <span class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[10px] font-mono uppercase tracking-wider">VOLCANIC TERROIR</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-amber-400 transition-colors" data-i18n="award2_title">
            MEJOR MICRO-LOTE VOLCÁNICO
          </h3>
          <p class="text-stone-400 text-sm font-light leading-relaxed font-sans" data-i18n="award2_desc">
            Reconocimiento por perfiles de taza excepcionales con notas de jazmín y miel silvestre.
          </p>
        </div>
        <div class="pt-6 border-t border-white/10 mt-8 font-mono text-[11px] text-stone-500 uppercase tracking-widest flex items-center justify-between">
          <span>MICRO-LOTE VERIFICADO</span>
          <span class="text-amber-400">★ ★ ★ ★ ★</span>
        </div>
      </div>

      <div class="bg-stone-900 border border-amber-500/20 p-8 sm:p-10 flex flex-col justify-between hover:border-amber-400 transition-all duration-300 group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl sm:text-4xl font-mono font-bold text-amber-400">PRIMER LUGAR</span>
            <span class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[10px] font-mono uppercase tracking-wider">INNOVACIÓN</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-amber-400 transition-colors" data-i18n="award3_title">
            CATA NACIONAL DE ESPECIALIDAD
          </h3>
          <p class="text-stone-400 text-sm font-light leading-relaxed font-sans" data-i18n="award3_desc">
            Primer lugar en la categoría de Innovación en Fermentación Controlada.
          </p>
        </div>
        <div class="pt-6 border-t border-white/10 mt-8 font-mono text-[11px] text-stone-500 uppercase tracking-widest flex items-center justify-between">
          <span>MICRO-LOTE VERIFICADO</span>
          <span class="text-amber-400">★ ★ ★ ★ ★</span>
        </div>
      </div>
    </div>

  </div>
</section>
