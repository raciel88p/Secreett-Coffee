---
const accolades = [
  {
    score: "92.5 SCA",
    award: "Cup of Excellence Costa Rica",
    category: "Micro-Lot Winner",
    description: "Highest scoring anaerobic Geisha micro-lot in Turrialba regional history."
  },
  {
    score: "Top 1%",
    award: "Specialty Coffee Expo 2024",
    category: "World Filter Roast",
    description: "Best Single-Origin Filter Roast awarded by an international Q-Grader panel."
  },
  {
    score: "Certified",
    award: "Global Roasters Guild",
    category: "Volcanic Agroforestry",
    description: "Recognized for sustainable high-altitude soil stewardship & transparent direct trade."
  }
];
---

<section id="awards" class="py-24 bg-[#050505] text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <!-- Centered Header -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-[#c5a059] font-bold block mb-3">
        Recognized Quality & National Pride
      </span>
      <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight mb-6">
        AWARD-WINNING <span class="font-serif italic font-normal text-[#c5a059]">accolades</span>
      </h2>
      <p class="text-gray-300 font-sans text-base sm:text-lg font-light leading-relaxed max-w-2xl mx-auto">
        Validated by international Q-Graders, world barista champions, and specialty coffee critics across the globe.
      </p>
    </div>

    <!-- Awards Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {accolades.map((acc) => (
        <div class="bg-[#0d0d0d] border border-[#c5a059]/20 p-8 sm:p-10 flex flex-col justify-between hover:border-[#c5a059] transition-all duration-300 group">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl sm:text-4xl font-mono font-bold text-[#c5a059]">
                {acc.score}
              </span>
              <span class="px-2.5 py-1 bg-[#c5a059]/10 border border-[#c5a059]/30 text-[#e6d7c3] text-[10px] font-mono uppercase tracking-wider">
                {acc.category}
              </span>
            </div>
            <h3 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-[#c5a059] transition-colors">
              {acc.award}
            </h3>
            <p class="text-gray-400 text-sm font-light leading-relaxed font-sans">
              "{acc.description}"
            </p>
          </div>
          <div class="pt-6 border-t border-white/10 mt-8 font-mono text-[11px] text-gray-500 uppercase tracking-widest flex items-center justify-between">
            <span>Verified Micro-Lot</span>
            <span class="text-[#c5a059]">★ ★ ★ ★ ★</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
