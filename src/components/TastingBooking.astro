---
---

<section id="booking" class="py-24 bg-stone-900 text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

      <!-- Info Left Side -->
      <div class="lg:col-span-5">
        <span class="text-xs font-mono uppercase tracking-widest text-amber-400 font-bold block mb-3" data-i18n="tasting_badge">
          EXPERIENCIA EXCLUSIVA DE CATA
        </span>
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight mb-6 leading-tight">
          <span data-i18n="tasting_title_1">RESERVE SU SESIÓN</span> <br/>
          <span class="font-serif italic font-normal text-amber-400 lowercase" data-i18n="tasting_title_2">PRIVADA DE CATA.</span>
        </h2>
        <p class="text-stone-300 font-sans text-base leading-relaxed mb-8 font-light" data-i18n="tasting_desc">
          Disfrute de una inmersión sensorial guiada por nuestro Q-Grader certificado en nuestra terraza privada con vista panorámica a las montañas de Turrialba.
        </p>

        <!-- Package highlights -->
        <div class="space-y-6 border-t border-white/10 pt-6">
          <div class="flex items-start gap-4">
            <span class="text-amber-400 font-mono text-xl font-bold">01</span>
            <div>
              <h3 class="font-bold uppercase tracking-wider text-sm mb-1 text-white" data-i18n="pkg1_title">Cata Sensorial Guiada</h3>
              <p class="text-stone-400 text-xs font-sans" data-i18n="pkg1_desc">Degustación de 4 micro-lotes de especialidad acompañados de maridaje artesanal local.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-400 font-mono text-xl font-bold">02</span>
            <div>
              <h3 class="font-bold uppercase tracking-wider text-sm mb-1 text-white" data-i18n="pkg2_title">Masterclass de Métodos y Tueste</h3>
              <p class="text-stone-400 text-xs font-sans" data-i18n="pkg2_desc">Experiencia interactiva de preparación en métodos de extracción manual y cata profesional.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Right Side -->
      <div class="lg:col-span-7 bg-stone-950 border border-white/10 p-8 sm:p-10">
        <form id="tasting-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-mono uppercase tracking-widest text-stone-300 mb-2" data-i18n="form_name_label">
                Nombre Completo
              </label>
              <input
                type="text"
                required
                placeholder="Juan Pérez"
                class="w-full bg-stone-900 border border-white/10 px-4 py-3 text-white focus:outline-none focus:border-amber-400 font-sans text-sm"
              />
            </div>
            <div>
              <label class="block text-xs font-mono uppercase tracking-widest text-stone-300 mb-2" data-i18n="form_email_label">
                Correo Electrónico
              </label>
              <input
                type="email"
                required
                placeholder="juan@ejemplo.com"
                class="w-full bg-stone-900 border border-white/10 px-4 py-3 text-white focus:outline-none focus:border-amber-400 font-sans text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-mono uppercase tracking-widest text-stone-300 mb-2" data-i18n="form_date_label">
                Fecha Deseada
              </label>
              <input
                type="date"
                required
                class="w-full bg-stone-900 border border-white/10 px-4 py-3 text-white focus:outline-none focus:border-amber-400 font-sans text-sm"
              />
            </div>
            <div>
              <label class="block text-xs font-mono uppercase tracking-widest text-stone-300 mb-2" data-i18n="form_guests_label">
                Número de Personas
              </label>
              <select class="w-full bg-stone-900 border border-white/10 px-4 py-3 text-white focus:outline-none focus:border-amber-400 font-sans text-sm">
                <option value="1-2">1 - 2 Personas</option>
                <option value="3-4">3 - 4 Personas</option>
                <option value="5+">5+ Grupo Privado</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-mono uppercase tracking-widest text-stone-300 mb-2" data-i18n="form_notes_label">
              Solicitudes Especiales
            </label>
            <textarea
              rows="3"
              placeholder="Detalles adicionales o requerimientos dietéticos..."
              class="w-full bg-stone-900 border border-white/10 px-4 py-3 text-white focus:outline-none focus:border-amber-400 font-sans text-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs uppercase tracking-widest font-bold transition-colors flex items-center justify-center gap-2"
            data-i18n="form_submit"
          >
            CONFIRMAR RESERVA VÍA WHATSAPP
          </button>
        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('tasting-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = encodeURIComponent('Hola Coffee Secret Turrialba, me gustaría reservar una experiencia de cata privada.');
      window.open(`https://wa.me/50688888888?text=${message}`, '_blank');
    });
  }
</script>
