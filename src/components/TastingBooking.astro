---
const experiences = [
  {
    id: "cupping",
    title: "Sensory Cupping & Origin Discovery",
    duration: "90 Minutes",
    price: "$45 USD",
    tag: "Most Popular",
    description: "Guided cupping session led by an SCA certified Q-Grader. Evaluate 5 distinct micro-lots from Turrialba, learning aroma profiling, acidity notes, and post-harvest fermentation differences.",
    includes: ["5 Single Origin Tastings", "Aroma Wheel Guide", "Artisanal Local Cheese Pairing"]
  },
  {
    id: "masterclass",
    title: "V60 & Espresso Barista Masterclass",
    duration: "2 Hours",
    price: "$75 USD",
    tag: "Exclusive",
    description: "Hands-on coffee extraction workshop using specialized water chemistry, precision grinder calibration, and pour-over geometry (V60, Chemex, Aeropress).",
    includes: ["Hands-on Espresso Pulling", "Pour-Over Calibration", "Fresh 250g Bag of Geisha Beans"]
  },
  {
    id: "sunset",
    title: "Sunset Volcanic Coffee & Cocktail Pairing",
    duration: "2.5 Hours",
    price: "$95 USD",
    tag: "VIP Luxury",
    description: "An intimate evening experience overlooking Turrialba volcano. Enjoy signature espresso-infused cocktails paired with gourmet 4-course estate chocolate and tapas.",
    includes: ["4 Signature Coffee Cocktails", "Gourmet Tapas Board", "Private Lounge Access"]
  }
];
---

<section id="booking" class="py-24 bg-[#050505] text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-8 border-b border-white/10 gap-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-[#c5a059] font-bold block mb-2">
          By Reservation Only
        </span>
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight">
          TASTING <span class="font-serif italic font-normal text-[#c5a059]">experiences</span>
        </h2>
      </div>
      <p class="text-gray-300 font-sans text-sm sm:text-base max-w-md leading-relaxed">
        Immersion into coffee perfection at our volcanic estate. Reservations are strictly limited to private groups to ensure personalized masterclasses.
      </p>
    </div>

    <!-- Experience Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      {experiences.map((exp) => (
        <div class="bg-[#0d0d0d] border border-[#c5a059]/20 p-8 flex flex-col justify-between hover:border-[#c5a059] transition-all duration-300 group">

          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-[10px] font-mono uppercase tracking-widest font-bold text-[#c5a059] border border-[#c5a059]/30 px-3 py-1 bg-[#c5a059]/10">
                {exp.tag}
              </span>
              <span class="text-xs font-mono text-gray-400">{exp.duration}</span>
            </div>

            <h3 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-[#c5a059] transition-colors">
              {exp.title}
            </h3>

            <div class="font-mono text-3xl font-bold text-[#c5a059] mb-6">
              {exp.price} <span class="text-xs text-gray-400 font-normal">/ guest</span>
            </div>

            <p class="text-gray-300 text-sm leading-relaxed mb-6 font-sans font-light">
              {exp.description}
            </p>

            <div class="space-y-2.5 pt-6 border-t border-white/10 mb-8 font-mono text-xs text-gray-300">
              {exp.includes.map((inc) => (
                <div class="flex items-center gap-2">
                  <span class="text-[#c5a059]">✓</span>
                  <span>{inc}</span>
                </div>
              ))}
            </div>
          </div>

          <button
            data-experience={exp.title}
            class="booking-select-btn w-full py-3.5 text-xs font-mono uppercase tracking-widest font-bold text-black bg-[#c5a059] hover:bg-[#e6d7c3] transition-colors text-center shadow-lg"
          >
            Select Experience
          </button>

        </div>
      ))}
    </div>

    <!-- Interactive Reservation Form -->
    <div class="max-w-4xl mx-auto bg-[#0d0d0d] p-8 sm:p-12 border border-[#c5a059]/30 relative">
      <div class="text-center mb-10">
        <span class="text-xs font-mono uppercase tracking-widest text-[#c5a059] block mb-2">Concierge Reservation</span>
        <h3 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white mb-2">Reserve Your Private Session</h3>
        <p class="text-xs font-mono text-gray-400">Direct instant confirmation via WhatsApp Concierge or email.</p>
      </div>

      <form id="tasting-form" class="space-y-6 font-mono text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block uppercase text-gray-300 mb-2 font-bold">Full Name</label>
            <input
              type="text"
              required
              id="booking-name"
              placeholder="e.g. Elena Rostova"
              class="w-full bg-[#050505] border border-white/20 px-4 py-3 text-white focus:outline-none focus:border-[#c5a059] transition-colors"
            />
          </div>

          <div>
            <label class="block uppercase text-gray-300 mb-2 font-bold">Selected Experience</label>
            <select
              id="booking-experience"
              class="w-full bg-[#050505] border border-white/20 px-4 py-3 text-white focus:outline-none focus:border-[#c5a059] transition-colors"
            >
              {experiences.map((exp) => (
                <option value={exp.title}>{exp.title}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label class="block uppercase text-gray-300 mb-2 font-bold">Preferred Date</label>
            <input
              type="date"
              required
              id="booking-date"
              class="w-full bg-[#050505] border border-white/20 px-4 py-3 text-white focus:outline-none focus:border-[#c5a059] transition-colors"
            />
          </div>

          <div>
            <label class="block uppercase text-gray-300 mb-2 font-bold">Time Slot</label>
            <select
              id="booking-time"
              class="w-full bg-[#050505] border border-white/20 px-4 py-3 text-white focus:outline-none focus:border-[#c5a059] transition-colors"
            >
              <option value="09:00 AM">09:00 AM (Morning Brew)</option>
              <option value="11:30 AM">11:30 AM (Midday Flight)</option>
              <option value="02:30 PM">02:30 PM (Afternoon Cupping)</option>
              <option value="04:30 PM">04:30 PM (Sunset Experience)</option>
            </select>
          </div>

          <div>
            <label class="block uppercase text-gray-300 mb-2 font-bold">Guests Count</label>
            <select
              id="booking-guests"
              class="w-full bg-[#050505] border border-white/20 px-4 py-3 text-white focus:outline-none focus:border-[#c5a059] transition-colors"
            >
              <option value="1 Person">1 Guest</option>
              <option value="2 People" selected>2 Guests</option>
              <option value="4 People">4 Guests</option>
              <option value="6 People">6 Guests (Private Group)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block uppercase text-gray-300 mb-2 font-bold">Special Notes or Dietary Requirements</label>
          <textarea
            id="booking-notes"
            rows="3"
            placeholder="Tell us about your coffee preferences or dietary requirements..."
            class="w-full bg-[#050505] border border-white/20 px-4 py-3 text-white focus:outline-none focus:border-[#c5a059] transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 text-xs font-mono uppercase tracking-widest font-bold text-black bg-[#c5a059] hover:bg-[#e6d7c3] transition-colors shadow-lg"
        >
          Confirm Reservation via WhatsApp Concierge &rarr;
        </button>
      </form>
    </div>

  </div>
</section>

<script>
  const tastingForm = document.getElementById('tasting-form');
  const expButtons = document.querySelectorAll('.booking-select-btn');
  const expSelect = document.getElementById('booking-experience') as HTMLSelectElement;

  if (expButtons && expSelect) {
    expButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const expName = btn.getAttribute('data-experience');
        if (expName) {
          expSelect.value = expName;
          document.getElementById('tasting-form')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }

  if (tastingForm) {
    tastingForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('booking-name') as HTMLInputElement)?.value;
      const experience = (document.getElementById('booking-experience') as HTMLSelectElement)?.value;
      const date = (document.getElementById('booking-date') as HTMLInputElement)?.value;
      const time = (document.getElementById('booking-time') as HTMLSelectElement)?.value;
      const guests = (document.getElementById('booking-guests') as HTMLSelectElement)?.value;
      const notes = (document.getElementById('booking-notes') as HTMLTextAreaElement)?.value;

      const message = `Hello Coffee Secret Turrialba! I would like to request a reservation:\n\n• Name: ${name}\n• Experience: ${experience}\n• Date: ${date}\n• Time: ${time}\n• Guests: ${guests}\n• Notes: ${notes || 'None'}`;

      const whatsappUrl = `https://wa.me/50688889999?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, '_blank');
    });
  }
</script>
