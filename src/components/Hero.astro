---
---

<section class="relative bg-black text-white overflow-hidden min-h-[90vh] lg:min-h-screen flex flex-col justify-between">

  <!-- Background Video Overlay -->
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      poster="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=1920&auto=format&fit=crop"
      class="w-full h-full object-cover filter brightness-[0.55] contrast-125"
    >
      <source src="https://assets.mixkit.co/videos/preview/mixkit-barista-pouring-coffee-into-a-cup-41009-large.mp4" type="video/mp4" />
      <source src="https://assets.mixkit.co/videos/preview/mixkit-coffee-beans-falling-41008-large.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-black/60"></div>
  </div>

  <!-- Hero Content Grid matching GoodBoyBob typography -->
  <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-8 w-full pt-28 sm:pt-36 pb-16 flex-1 flex flex-col justify-end">

    <div class="max-w-4xl">
      <!-- Badge / Subtitle -->
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 backdrop-blur-md border border-white/20 text-amber-300 text-xs font-mono tracking-widest uppercase mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Direct Harvest • Volcanic Micro-lot Costa Rica
      </div>

      <!-- Main Headline in GoodBoyBob Style -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black uppercase tracking-tight leading-[0.92] mb-6 text-white">
        THE BEST <br/>
        <span class="font-serif italic font-normal text-amber-300">TURRIALBA</span> <br/>
        COFFEE BREW.
      </h1>

      <p class="text-lg sm:text-2xl font-light text-gray-200 max-w-2xl mb-8 leading-relaxed font-sans">
        Start your day with a hidden specialty coffee experience from the volcanic cloud forests of Costa Rica. Sourced with devotion, roasted for extraordinary clarity.
      </p>

      <!-- CTAs in GoodBoyBob high contrast block style -->
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#menu"
          class="px-8 py-4 bg-white text-black font-mono text-xs uppercase tracking-widest font-black hover:bg-amber-400 transition-all duration-200 shadow-lg"
        >
          Shop Micro-Lots
        </a>
        <a
          href="#booking"
          class="px-8 py-4 bg-transparent border-2 border-white text-white font-mono text-xs uppercase tracking-widest font-black hover:bg-white hover:text-black transition-all duration-200"
        >
          Book Tasting Room
        </a>
      </div>
    </div>

    <!-- Bottom Highlights Ticker / Bar -->
    <div class="mt-16 pt-8 border-t border-white/15 grid grid-cols-2 md:grid-cols-4 gap-6 font-mono text-xs uppercase text-gray-300 tracking-wider">
      <div>
        <span class="block text-gray-400 text-[10px]">Cupping Score</span>
        <span class="text-amber-300 text-base font-bold">92.5+ Specialty</span>
      </div>
      <div>
        <span class="block text-gray-400 text-[10px]">Altitude</span>
        <span class="text-white text-base font-bold">1,650 Meters</span>
      </div>
      <div>
        <span class="block text-gray-400 text-[10px]">Terroir</span>
        <span class="text-white text-base font-bold">Volcanic Soil</span>
      </div>
      <div>
        <span class="block text-gray-400 text-[10px]">Variety</span>
        <span class="text-amber-300 text-base font-bold">Geisha & SL-28</span>
      </div>
    </div>

  </div>

</section>
