<script>
  import { setLanguage } from '../scripts/i18n.js';

  document.getElementById('bottom-lang-toggle')?.addEventListener('click', () => {
    const current = localStorage.getItem('cs_lang') || 'es';
    const next = current === 'es' ? 'en' : 'es';
    setLanguage(next);
  });
</script>
