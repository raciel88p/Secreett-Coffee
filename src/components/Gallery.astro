---
const galleryItems = [
  {
    image: "https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=800&auto=format&fit=crop",
    caption: "Morning fog clearing over our high altitude Geisha micro-lot in Santa Cruz, Turrialba.",
    likes: "1,240",
    comments: "84",
    tag: "@coffeesecretturrialba"
  },
  {
    image: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=800&auto=format&fit=crop",
    caption: "Precision extraction with V60 using 92°C mountain spring water.",
    likes: "982",
    comments: "42",
    tag: "#SpecialtyCoffee"
  },
  {
    image: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=800&auto=format&fit=crop",
    caption: "Handpicking only 100% ripe red cherries on the volcanic slopes.",
    likes: "2,105",
    comments: "116",
    tag: "#CupOfExcellence"
  },
  {
    image: "https://images.unsplash.com/photo-1511920170033-f8396924c348?q=80&w=800&auto=format&fit=crop",
    caption: "Anaerobic stainless steel fermentation tanks in action.",
    likes: "1,530",
    comments: "79",
    tag: "#CoffeeInnovation"
  },
  {
    image: "https://images.unsplash.com/photo-1511537190424-bbbab87ac5eb?q=80&w=800&auto=format&fit=crop",
    caption: "Sunset view over the Turrialba Volcano during private cupping sessions.",
    likes: "3,410",
    comments: "210",
    tag: "#TurrialbaCostaRica"
  },
  {
    image: "https://images.unsplash.com/photo-1524350876685-274059332603?q=80&w=800&auto=format&fit=crop",
    caption: "Freshly roasted single origin beans ready for cupping evaluation.",
    likes: "1,890",
    comments: "95",
    tag: "#QGrader"
  }
];
---

<section id="gallery" class="py-24 bg-[#050505] text-white border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#0d0d0d] border border-[#c5a059]/30 rounded-full mb-4">
        <span class="text-xs font-mono text-[#c5a059]">@coffeesecretturrialba</span>
      </div>
      <h2 class="font-black text-3xl sm:text-5xl uppercase tracking-tight mb-4">
        VISUAL <span class="font-serif italic font-normal text-[#c5a059]">journal</span>
      </h2>
      <p class="text-gray-300 text-sm sm:text-base font-light">
        Moments captured inside our mountain estate and tasting sanctuary.
      </p>
    </div>

    <!-- Instagram Style Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {galleryItems.map((item) => (
        <div class="group relative overflow-hidden bg-[#0d0d0d] border border-[#c5a059]/20 transition-all duration-500 hover:border-[#c5a059]">
          <div class="aspect-square w-full overflow-hidden bg-black">
            <img
              src={item.image}
              alt={item.caption}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
            />
          </div>

          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-[#050505]/85 backdrop-blur-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs text-[#c5a059] font-mono">
              <span>{item.tag}</span>
              <span class="text-white">📸 Instagram</span>
            </div>

            <p class="text-xs text-gray-200 font-light leading-relaxed italic">
              "{item.caption}"
            </p>

            <div class="flex items-center gap-6 pt-4 border-t border-white/10 text-xs text-gray-300">
              <span class="flex items-center gap-1.5">
                ❤️ <span class="font-semibold text-white">{item.likes}</span>
              </span>
              <span class="flex items-center gap-1.5">
                💬 <span class="font-semibold text-white">{item.comments}</span>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-3 text-xs uppercase font-mono tracking-widest font-bold text-[#c5a059] border border-[#c5a059]/40 hover:border-[#c5a059] hover:bg-[#c5a059]/10 transition-all duration-300"
      >
        <span>Follow @coffeesecretturrialba On Instagram</span>
        <span>&rarr;</span>
      </a>
    </div>

  </div>
</section>
