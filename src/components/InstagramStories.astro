---
---

<section class="py-6 bg-stone-950 border-b border-amber-900/20 sticky top-[72px] z-30 bg-opacity-95 backdrop-blur-md">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8">

    <!-- Stories Carousel -->
    <div class="flex items-center justify-start sm:justify-center gap-4 sm:gap-6 overflow-x-auto no-scrollbar py-2 px-1">

      <!-- Story Bubble 1: Terroir -->
      <button
        class="story-bubble flex flex-col items-center gap-2 group flex-shrink-0 cursor-pointer focus:outline-none"
        data-story-idx="0"
      >
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-[2px] bg-gradient-to-tr from-amber-600 via-yellow-400 to-amber-700 group-hover:scale-105 transition-transform shadow-lg shadow-amber-950/40">
          <div class="w-full h-full rounded-full border-2 border-stone-950 overflow-hidden relative">
            <img
              src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=300&auto=format&fit=crop"
              alt="Volcán & Terroir"
              class="w-full h-full object-cover"
              loading="lazy"
            >
            <div class="absolute inset-0 bg-stone-950/20 group-hover:bg-transparent transition-colors"></div>
          </div>
        </div>
        <span class="text-[11px] font-mono tracking-wider text-stone-300 group-hover:text-amber-400 transition-colors uppercase" data-i18n="story_tag_1">
          Volcán
        </span>
      </button>

      <!-- Story Bubble 2: Geisha -->
      <button
        class="story-bubble flex flex-col items-center gap-2 group flex-shrink-0 cursor-pointer focus:outline-none"
        data-story-idx="1"
      >
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-[2px] bg-gradient-to-tr from-amber-600 via-yellow-400 to-amber-700 group-hover:scale-105 transition-transform shadow-lg shadow-amber-950/40">
          <div class="w-full h-full rounded-full border-2 border-stone-950 overflow-hidden relative">
            <img
              src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=300&auto=format&fit=crop"
              alt="Geisha Lot"
              class="w-full h-full object-cover"
              loading="lazy"
            >
            <div class="absolute inset-0 bg-stone-950/20 group-hover:bg-transparent transition-colors"></div>
          </div>
        </div>
        <span class="text-[11px] font-mono tracking-wider text-stone-300 group-hover:text-amber-400 transition-colors uppercase" data-i18n="story_tag_2">
          Geisha
        </span>
      </button>

      <!-- Story Bubble 3: Cata Privada -->
      <button
        class="story-bubble flex flex-col items-center gap-2 group flex-shrink-0 cursor-pointer focus:outline-none"
        data-story-idx="2"
      >
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-[2px] bg-gradient-to-tr from-amber-600 via-yellow-400 to-amber-700 group-hover:scale-105 transition-transform shadow-lg shadow-amber-950/40">
          <div class="w-full h-full rounded-full border-2 border-stone-950 overflow-hidden relative">
            <img
              src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=300&auto=format&fit=crop"
              alt="Cata Guiada"
              class="w-full h-full object-cover"
              loading="lazy"
            >
            <div class="absolute inset-0 bg-stone-950/20 group-hover:bg-transparent transition-colors"></div>
          </div>
        </div>
        <span class="text-[11px] font-mono tracking-wider text-stone-300 group-hover:text-amber-400 transition-colors uppercase" data-i18n="story_tag_3">
          Tasting
        </span>
      </button>

      <!-- Story Bubble 4: Fermentación -->
      <button
        class="story-bubble flex flex-col items-center gap-2 group flex-shrink-0 cursor-pointer focus:outline-none"
        data-story-idx="3"
      >
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-[2px] bg-gradient-to-tr from-amber-600 via-yellow-400 to-amber-700 group-hover:scale-105 transition-transform shadow-lg shadow-amber-950/40">
          <div class="w-full h-full rounded-full border-2 border-stone-950 overflow-hidden relative">
            <img
              src="https://images.unsplash.com/photo-1511920170033-f8396924c348?q=80&w=300&auto=format&fit=crop"
              alt="Fermentación Anaeróbica"
              class="w-full h-full object-cover"
              loading="lazy"
            >
            <div class="absolute inset-0 bg-stone-950/20 group-hover:bg-transparent transition-colors"></div>
          </div>
        </div>
        <span class="text-[11px] font-mono tracking-wider text-stone-300 group-hover:text-amber-400 transition-colors uppercase" data-i18n="story_tag_4">
          Process
        </span>
      </button>

      <!-- Story Bubble 5: Barista Craft -->
      <button
        class="story-bubble flex flex-col items-center gap-2 group flex-shrink-0 cursor-pointer focus:outline-none"
        data-story-idx="4"
      >
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-[2px] bg-gradient-to-tr from-amber-600 via-yellow-400 to-amber-700 group-hover:scale-105 transition-transform shadow-lg shadow-amber-950/40">
          <div class="w-full h-full rounded-full border-2 border-stone-950 overflow-hidden relative">
            <img
              src="https://images.unsplash.com/photo-1447933601403-0c6688de566e?q=80&w=300&auto=format&fit=crop"
              alt="Pour Over Masterclass"
              class="w-full h-full object-cover"
              loading="lazy"
            >
            <div class="absolute inset-0 bg-stone-950/20 group-hover:bg-transparent transition-colors"></div>
          </div>
        </div>
        <span class="text-[11px] font-mono tracking-wider text-stone-300 group-hover:text-amber-400 transition-colors uppercase" data-i18n="story_tag_5">
          Pour Over
        </span>
      </button>

    </div>
  </div>
</section>

<!-- Instagram Story Fullscreen Modal -->
<div
  id="story-modal"
  class="fixed inset-0 z-50 bg-stone-950/95 backdrop-blur-xl hidden flex items-center justify-center p-0 sm:p-4"
>
  <div class="relative w-full h-full sm:h-[85vh] sm:max-w-md bg-stone-900 sm:rounded-3xl overflow-hidden flex flex-col shadow-2xl border border-stone-800">

    <!-- Top Progress Bars -->
    <div class="absolute top-3 left-3 right-3 z-20 flex gap-1.5">
      <div class="h-1 flex-1 bg-white/30 rounded-full overflow-hidden">
        <div id="story-progress-bar" class="h-full bg-amber-400 w-0 transition-all duration-100 ease-linear"></div>
      </div>
    </div>

    <!-- Header info -->
    <div class="absolute top-6 left-4 right-4 z-20 flex items-center justify-between text-white">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full p-[1.5px] bg-gradient-to-tr from-amber-500 to-yellow-400">
          <img
            src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=150&auto=format&fit=crop"
            class="w-full h-full object-cover rounded-full border border-stone-900"
            alt="Coffee Secret Avatar"
          />
        </div>
        <div>
          <span class="font-sans font-bold text-xs text-white uppercase tracking-wider block">Coffee Secret Turrialba</span>
          <span id="story-time-badge" class="font-mono text-[10px] text-amber-400 block">Turrialba Volcano • 1,650m</span>
        </div>
      </div>

      <!-- Close button -->
      <button id="close-story-modal" class="w-9 h-9 rounded-full bg-stone-950/60 backdrop-blur-md flex items-center justify-center text-white text-lg hover:bg-amber-600 transition-colors focus:outline-none">
        ✕
      </button>
    </div>

    <!-- Story Media View -->
    <div class="relative flex-1 bg-black overflow-hidden flex items-center justify-center">
      <img id="story-image" src="" alt="Story Media" class="w-full h-full object-cover" />

      <!-- Touch Controls (Left / Right) -->
      <div id="story-prev-tap" class="absolute top-0 bottom-0 left-0 w-1/3 z-10 cursor-pointer"></div>
      <div id="story-next-tap" class="absolute top-0 bottom-0 right-0 w-2/3 z-10 cursor-pointer"></div>

      <!-- Story Caption Overlay -->
      <div class="absolute bottom-20 left-4 right-4 z-20 bg-stone-950/70 backdrop-blur-md p-4 rounded-2xl border border-stone-800">
        <p id="story-caption" class="text-sm font-light text-stone-200 leading-relaxed font-sans mb-2"></p>
        <span id="story-tag" class="text-xs font-mono text-amber-400 font-bold uppercase tracking-widest block"></span>
      </div>
    </div>

    <!-- Story Footer CTA -->
    <div class="p-4 bg-stone-950 border-t border-stone-800 flex items-center justify-between gap-3 z-20">
      <a
        href="#booking"
        id="story-cta-btn"
        class="flex-1 py-3 px-4 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-yellow-500 text-stone-950 font-mono font-bold text-xs uppercase tracking-widest text-center rounded-xl transition-all shadow-lg shadow-amber-600/20"
      >
        RESERVAR CATA VÍA WHATSAPP →
      </a>
    </div>

  </div>
</div>

<script>
  const storyData = [
    {
      img: "https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=800&auto=format&fit=crop",
      caption: "Cosechado a 1,650 metros en las faldas fértiles del Volcán Turrialba. Terroir único de niebla y ceniza mineral.",
      tag: "#VolcanicTerroir #TurrialbaOrigin",
      time: "Finca Turrialba • Costa Rica"
    },
    {
      img: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=800&auto=format&fit=crop",
      caption: "Micro-lote Geisha de Fermentación Anaeróbica de 120 Horas. Galardonado en Cup of Excellence.",
      tag: "#GeishaCoffee #AnaerobicFermentation",
      time: "Cosecha Reserva • 91.5 SCA"
    },
    {
      img: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=800&auto=format&fit=crop",
      caption: "Experiencia de cata privada guiada por nuestro Q-Grader certificado en nuestro deck panorámico.",
      tag: "#CuppingSession #QGraderTasting",
      time: "Terraza Coffee Secret"
    },
    {
      img: "https://images.unsplash.com/photo-1511920170033-f8396924c348?q=80&w=800&auto=format&fit=crop",
      caption: "Procesamiento artesanal en tanques anaeróbicos sellados para concentrar azúcares naturales de la cereza.",
      tag: "#MicroLotCraft #SpecialtyCoffee",
      time: "Beneficio Artesanal"
    },
    {
      img: "https://images.unsplash.com/photo-1447933601403-0c6688de566e?q=80&w=800&auto=format&fit=crop",
      caption: "Métodos de extracción de precisión en V60 y Chemex para resaltar notas florales de jazmín y miel.",
      tag: "#PourOverMastery #V60Brew",
      time: "Brew Bar Experiencia"
    }
  ];

  let currentIdx = 0;
  let progressInterval = null;
  let progress = 0;

  const modal = document.getElementById('story-modal');
  const storyImage = document.getElementById('story-image') as HTMLImageElement;
  const storyCaption = document.getElementById('story-caption');
  const storyTag = document.getElementById('story-tag');
  const storyTime = document.getElementById('story-time-badge');
  const progressBar = document.getElementById('story-progress-bar');
  const closeBtn = document.getElementById('close-story-modal');
  const prevTap = document.getElementById('story-prev-tap');
  const nextTap = document.getElementById('story-next-tap');
  const storyCta = document.getElementById('story-cta-btn');

  function openStory(idx) {
    currentIdx = idx;
    showStoryData();
    modal?.classList.remove('hidden');
    startProgressBar();
  }

  function closeStory() {
    modal?.classList.add('hidden');
    clearInterval(progressInterval);
    progress = 0;
  }

  function showStoryData() {
    const data = storyData[currentIdx];
    if (storyImage) storyImage.src = data.img;
    if (storyCaption) storyCaption.textContent = data.caption;
    if (storyTag) storyTag.textContent = data.tag;
    if (storyTime) storyTime.textContent = data.time;
  }

  function startProgressBar() {
    clearInterval(progressInterval);
    progress = 0;
    if (progressBar) progressBar.style.width = '0%';

    progressInterval = setInterval(() => {
      progress += 2;
      if (progressBar) progressBar.style.width = `${progress}%`;
      if (progress >= 100) {
        nextStory();
      }
    }, 100);
  }

  function nextStory() {
    if (currentIdx < storyData.length - 1) {
      currentIdx++;
      showStoryData();
      startProgressBar();
    } else {
      closeStory();
    }
  }

  function prevStory() {
    if (currentIdx > 0) {
      currentIdx--;
      showStoryData();
      startProgressBar();
    } else {
      startProgressBar();
    }
  }

  document.querySelectorAll('.story-bubble').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-story-idx') || '0', 10);
      openStory(idx);
    });
  });

  closeBtn?.addEventListener('click', closeStory);
  nextTap?.addEventListener('click', nextStory);
  prevTap?.addEventListener('click', prevStory);
  storyCta?.addEventListener('click', closeStory);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
