---
---

<section id="menu" class="py-24 bg-stone-950 text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-amber-400 font-bold block mb-3" data-i18n="menu_badge">
        MENÚ EXCLUSIVO DE MICRO-LOTES
      </span>
      <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight mb-6">
        <span data-i18n="menu_title_1">NUESTRA SELECCIÓN</span> <span class="font-serif italic font-normal text-amber-400" data-i18n="menu_title_2">DE CAFÉS DE ESPECIALIDAD.</span>
      </h2>
    </div>

    <!-- Menu Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- Item 1 -->
      <div class="bg-stone-900 border border-white/10 p-8 flex flex-col justify-between hover:border-amber-400 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-amber-500/10 text-amber-300 font-mono text-[10px] tracking-widest uppercase border border-amber-500/30" data-i18n="menu_tag_geisha">
              GEISHA • ANAERÓBICO
            </span>
            <span class="font-mono text-xl font-bold text-amber-400">$38 USD</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 text-white" data-i18n="menu_item1_title">
            Geisha Volcánico Anaeróbico
          </h3>
          <p class="text-stone-300 text-sm font-sans font-light leading-relaxed mb-6" data-i18n="menu_item1_desc">
            Perfil ultra elegante con notas intensas a jazmín, bergamota, melocotón blanco y un final prolongado a miel de azahar.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex justify-between items-center font-mono text-xs text-stone-400">
          <span>Altitud: 1,650m</span>
          <span>SCA: 92.5</span>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="bg-stone-900 border border-white/10 p-8 flex flex-col justify-between hover:border-amber-400 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-amber-500/10 text-amber-300 font-mono text-[10px] tracking-widest uppercase border border-amber-500/30" data-i18n="menu_tag_bourbon">
              RED BOURBON • HONEY
            </span>
            <span class="font-mono text-xl font-bold text-amber-400">$28 USD</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 text-white" data-i18n="menu_item2_title">
            Red Bourbon Honey Silvestre
          </h3>
          <p class="text-stone-300 text-sm font-sans font-light leading-relaxed mb-6" data-i18n="menu_item2_desc">
            Cuerpo sedoso con dulzura compleja de caña de azúcar, cereza madura, acidez málica y notas de chocolate negro.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex justify-between items-center font-mono text-xs text-stone-400">
          <span>Altitud: 1,600m</span>
          <span>SCA: 89.0</span>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="bg-stone-900 border border-white/10 p-8 flex flex-col justify-between hover:border-amber-400 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-amber-500/10 text-amber-300 font-mono text-[10px] tracking-widest uppercase border border-amber-500/30" data-i18n="menu_tag_catuai">
              YELLOW CATUAI • LAVADO
            </span>
            <span class="font-mono text-xl font-bold text-amber-400">$24 USD</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 text-white" data-i18n="menu_item3_title">
            Yellow Catuai Lavado Clásico
          </h3>
          <p class="text-stone-300 text-sm font-sans font-light leading-relaxed mb-6" data-i18n="menu_item3_desc">
            Taza limpia y brillante con notas de mandarina, avellana tostada y dulzura sostenida de caramelo artesanal.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex justify-between items-center font-mono text-xs text-stone-400">
          <span>Altitud: 1,550m</span>
          <span>SCA: 87.5</span>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="bg-stone-900 border border-white/10 p-8 flex flex-col justify-between hover:border-amber-400 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-amber-500/10 text-amber-300 font-mono text-[10px] tracking-widest uppercase border border-amber-500/30" data-i18n="menu_tag_coldbrew">
              COLD BREW • INFUSIÓN
            </span>
            <span class="font-mono text-xl font-bold text-amber-400">$18 USD</span>
          </div>
          <h3 class="text-2xl font-black uppercase tracking-tight mb-3 text-white" data-i18n="menu_item4_title">
            Cold Brew Reserva Nitro 24 Horas
          </h3>
          <p class="text-stone-300 text-sm font-sans font-light leading-relaxed mb-6" data-i18n="menu_item4_desc">
            Extracción lenta en frío infundida con nitrógeno para una textura cremosa con matices de flor de cacao y frambuesa.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex justify-between items-center font-mono text-xs text-stone-400">
          <span>Proceso: Cold Nitro</span>
          <span>Edición Limitada</span>
        </div>
      </div>

    </div>

  </div>
</section>
