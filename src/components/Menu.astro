---

<section id="menu" class="py-24 bg-[#050505] text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-8 border-b border-white/10 gap-6">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-[#c5a059] font-bold block mb-2">
          Direct From Santa Cruz, Turrialba
        </span>
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight">
          FEATURED <span class="font-serif italic font-normal text-[#c5a059]">micro-lots</span>
        </h2>
      </div>
      <p class="text-gray-300 font-sans text-sm sm:text-base max-w-md leading-relaxed">
        Grown at high elevation, selectively harvested, and micro-batch roasted for extreme clarity. Worldwide express shipping available.
      </p>
    </div>

    <!-- Product Grid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((item) => (
        <div class="group bg-[#0d0d0d] border border-[#c5a059]/20 hover:border-[#c5a059] transition-all duration-300 flex flex-col justify-between overflow-hidden">

          <!-- Image Wrapper -->
          <div class="relative aspect-square overflow-hidden bg-black">
            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 filter contrast-110 brightness-90"
            />
            <div class="absolute top-4 left-4 bg-[#050505]/90 backdrop-blur-md px-3 py-1 border border-[#c5a059]/40 text-[10px] font-mono tracking-widest uppercase text-[#c5a059]">
              {item.subtitle}
            </div>
            <div class="absolute bottom-4 right-4 bg-[#c5a059] text-black px-3 py-1 font-mono text-sm font-bold shadow-lg">
              {item.price}
            </div>
          </div>

          <!-- Content Details -->
          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">
                {item.process} • {item.elevation}
              </div>
              <h3 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-[#c5a059] transition-colors">
                {item.name}
              </h3>

              <!-- Tasting Notes Pills -->
              <div class="flex flex-wrap gap-1.5 my-4">
                {item.notes.map((note) => (
                  <span class="px-2.5 py-1 bg-white/5 border border-white/10 text-[11px] font-mono text-gray-300">
                    {note}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Button -->
            <div class="pt-6 border-t border-white/10 mt-6 flex items-center justify-between">
              <span class="text-xs font-mono text-[#c5a059]">{item.roast}</span>
              <a
                href={`https://wa.me/50688889999?text=${encodeURIComponent(item.whatsappMsg)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 bg-[#c5a059] text-black font-mono text-xs uppercase tracking-widest font-bold hover:bg-[#e6d7c3] transition-all duration-200"
              >
                Reserve Bag &rarr;
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Banner Wholesale Note -->
    <div class="mt-16 p-8 bg-[#0d0d0d] border border-[#c5a059]/30 text-center flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-left">
        <h4 class="text-xl font-black uppercase tracking-tight">Looking for Wholesale or Custom Roasts?</h4>
        <p class="text-sm text-gray-400 font-light mt-1">We partner with luxury cafes, boutique hotels, and private coffee cellars globally.</p>
      </div>
      <a
        href="https://wa.me/50688889999?text=Hello!%20I%20am%20interested%20in%20wholesale%20specialty%20coffee%20from%20Coffee%20Secret%20Turrialba."
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-8 py-3 bg-[#c5a059] text-black font-mono text-xs uppercase tracking-widest font-bold hover:bg-[#e6d7c3] transition-colors"
      >
        Inquire Wholesale
      </a>
    </div>

  </div>
</section>
