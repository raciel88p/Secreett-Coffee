---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Awards from '../components/Awards.astro';
import OriginStory from '../components/OriginStory.astro';
import Timeline from '../components/Timeline.astro';
import TastingBooking from '../components/TastingBooking.astro';
import Menu from '../components/Menu.astro';
import Gallery from '../components/Gallery.astro';
import TourismGuide from '../components/TourismGuide.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout>
  <Header />

  <main>
    <Hero />
    <Awards />
    <OriginStory />
    <Timeline />
    <TastingBooking />
    <Menu />
    <Gallery />
    <TourismGuide />
  </main>

  <footer class="bg-[#0a0806] border-t border-[#d4af37]/20 py-16 text-xs text-gray-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full border border-[#d4af37] flex items-center justify-center text-[#d4af37] font-serif font-bold text-sm">CS</div>
            <span class="font-serif text-lg text-white font-bold tracking-widest uppercase">Coffee Secret</span>
          </div>
          <p class="text-gray-400 font-light leading-relaxed">
            A hidden specialty coffee sanctuary in the volcanic highlands of Turrialba, Costa Rica.
          </p>
        </div>

        <div>
          <h4 class="font-serif text-sm text-white font-semibold mb-4 uppercase tracking-wider text-[#d4af37]">Navigation</h4>
          <ul class="space-y-2">
            <li><a href="#origin" class="hover:text-white transition-colors">Origin Story</a></li>
            <li><a href="#awards" class="hover:text-white transition-colors">Awards & Recognitions</a></li>
            <li><a href="#timeline" class="hover:text-white transition-colors">Seed to Cup Process</a></li>
            <li><a href="#menu" class="hover:text-white transition-colors">Specialty Menu</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-serif text-sm text-white font-semibold mb-4 uppercase tracking-wider text-[#d4af37]">Experiences</h4>
          <ul class="space-y-2">
            <li><a href="#booking" class="hover:text-white transition-colors">Sensory Cupping Flight</a></li>
            <li><a href="#booking" class="hover:text-white transition-colors">Pour-Over Masterclass</a></li>
            <li><a href="#booking" class="hover:text-white transition-colors">Sunset Coffee Cocktails</a></li>
            <li><a href="#tourism" class="hover:text-white transition-colors">Turrialba Destination Guide</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-serif text-sm text-white font-semibold mb-4 uppercase tracking-wider text-[#d4af37]">Contact & Location</h4>
          <p class="text-gray-300 mb-2">Santa Cruz, Volcán Turrialba, Cartago, Costa Rica</p>
          <p class="text-gray-300 mb-2">WhatsApp Concierge: +506 8888 9999</p>
          <p class="text-gray-300">Email: concierge@coffeesecretturrialba.cr</p>
        </div>
      </div>

      <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-gray-500">
        <p>© {new Date().getFullYear()} Coffee Secret Turrialba. All rights reserved.</p>
        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-gray-400">Privacy Policy</a>
          <a href="#" class="hover:text-gray-400">Terms of Experience</a>
          <a href="#" class="hover:text-gray-400">SCA Certified Estate</a>
        </div>
      </div>
    </div>
  </footer>

  <WhatsAppButton />
</Layout>

<script>
  import { initAnimations } from '../scripts/animations.js';

  document.addEventListener('DOMContentLoaded', () => {
    initAnimations();
  });
</script>
