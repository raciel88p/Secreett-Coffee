---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InstagramStories from '../components/InstagramStories.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import OriginStory from '../components/OriginStory.astro';
import Awards from '../components/Awards.astro';
import Timeline from '../components/Timeline.astro';
import TastingBooking from '../components/TastingBooking.astro';
import Gallery from '../components/Gallery.astro';
import TourismGuide from '../components/TourismGuide.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BottomNav from '../components/BottomNav.astro';
---

<Layout>
  <Header />
  <InstagramStories />

  <main>
    <Hero />
    <Menu />
    <OriginStory />
    <Awards />
    <Timeline />
    <TastingBooking />
    <Gallery />
    <TourismGuide />
  </main>

  <!-- Global Footer -->
  <footer class="bg-black border-t border-white/10 pt-16 pb-12 text-white font-mono text-xs">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8">

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-16 pb-16 border-b border-white/10">

        <!-- Brand Description -->
        <div class="lg:col-span-2 pr-0 lg:pr-8">
          <span class="font-sans font-black tracking-tighter text-3xl text-white uppercase block mb-4">
            COFFEE SECRET<span class="text-amber-400 font-serif italic text-2xl font-normal">.cr</span>
          </span>
          <p class="text-gray-400 font-sans font-light text-sm leading-relaxed mb-6" data-i18n="footer_desc">
            Un destino elevado de café de especialidad escondido en los bosques nubosos volcánicos de Turrialba, Costa Rica. Cultivado con devoción, tostado para máxima claridad, enviado a todo el mundo.
          </p>
          <div class="text-amber-400 font-bold uppercase tracking-widest text-[11px]" data-i18n="footer_sca">
            Certificación SCA • Finca de Comercio Directo
          </div>
        </div>

        <!-- Explore Links -->
        <div>
          <h4 class="text-amber-400 font-bold uppercase tracking-widest mb-4" data-i18n="footer_title_explore">Explorar</h4>
          <ul class="space-y-2.5 text-gray-300">
            <li><a href="#menu" class="hover:text-amber-400 transition-colors" data-i18n="footer_link_microlots">Comprar Micro-Lotes</a></li>
            <li><a href="#origin" class="hover:text-amber-400 transition-colors" data-i18n="footer_link_mission">Nuestra Misión</a></li>
            <li><a href="#awards" class="hover:text-amber-400 transition-colors" data-i18n="footer_link_awards">Reconocimientos</a></li>
            <li><a href="#timeline" class="hover:text-amber-400 transition-colors" data-i18n="footer_link_process">De la Semilla a la Taza</a></li>
            <li><a href="#booking" class="hover:text-amber-400 transition-colors" data-i18n="footer_link_tasting">Sala de Cata</a></li>
          </ul>
        </div>

        <!-- Locations -->
        <div>
          <h4 class="text-amber-400 font-bold uppercase tracking-widest mb-4" data-i18n="footer_title_locations">Ubicación</h4>
          <ul class="space-y-2.5 text-gray-300 font-sans text-xs">
            <li class="font-bold font-mono text-white" data-i18n="footer_estate">Finca Turrialba:</li>
            <li data-i18n="footer_address">KM 14 Ruta Volcán Turrialba</li>
          </ul>
        </div>

        <!-- Contact & Newsletter -->
        <div>
          <h4 class="text-amber-400 font-bold uppercase tracking-widest mb-4" data-i18n="footer_title_contact">Contacto</h4>
          <p class="text-gray-300 mb-2">WhatsApp: +506 8888 9999</p>
          <p class="text-gray-300 mb-4">concierge@coffeesecretturrialba.cr</p>
          <a
            href="#booking"
            class="inline-block px-4 py-2 bg-white text-black font-mono text-[11px] uppercase font-bold tracking-widest hover:bg-amber-400 transition-colors"
            data-i18n="footer_inquire"
          >
            Consultar Reserva
          </a>
        </div>

      </div>

      <!-- Footer Bottom -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-gray-500 text-[11px]">
        <p>© {new Date().getFullYear()} <span data-i18n="footer_rights">Coffee Secret Turrialba. Todos los derechos reservados.</span></p>
        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-white transition-colors" data-i18n="footer_privacy">Política de Privacidad</a>
          <a href="#" class="hover:text-white transition-colors" data-i18n="footer_terms">Términos de Servicio</a>
          <a href="#" class="hover:text-white transition-colors" data-i18n="footer_origin">Origen Costa Rica</a>
        </div>
      </div>

    </div>
  </footer>

  <WhatsAppButton />
  <BottomNav />
</Layout>

<script>
  import { initAnimations } from '../scripts/animations.js';

  document.addEventListener('DOMContentLoaded', () => {
    initAnimations();
  });
</script>
