---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import OriginStory from '../components/OriginStory.astro';
import Awards from '../components/Awards.astro';
import Timeline from '../components/Timeline.astro';
import TastingBooking from '../components/TastingBooking.astro';
import Gallery from '../components/Gallery.astro';
import TourismGuide from '../components/TourismGuide.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout>
  <Header />

  <main>
    <Hero />
    <Menu />
    <OriginStory />
    <Awards />
    <Timeline />
    <TastingBooking />
    <Gallery />
    <TourismGuide />
  </main>

  <!-- GoodBoyBob Style Global Footer -->
  <footer class="bg-black border-t border-white/10 pt-16 pb-12 text-white font-mono text-xs">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8">

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-16 pb-16 border-b border-white/10">

        <!-- Brand Description -->
        <div class="lg:col-span-2 pr-0 lg:pr-8">
          <span class="font-sans font-black tracking-tighter text-3xl text-white uppercase block mb-4">
            COFFEE SECRET<span class="text-amber-400 font-serif italic text-2xl font-normal">.cr</span>
          </span>
          <p class="text-gray-400 font-sans font-light text-sm leading-relaxed mb-6">
            An elevated specialty coffee destination hidden in the volcanic cloud forests of Turrialba, Costa Rica. Sourced with devotion, roasted for clarity, delivered worldwide.
          </p>
          <div class="text-amber-400 font-bold uppercase tracking-widest text-[11px]">
            SCA Certified • Direct Trade Estate
          </div>
        </div>

        <!-- Explore Links -->
        <div>
          <h4 class="text-amber-400 font-bold uppercase tracking-widest mb-4">Explore</h4>
          <ul class="space-y-2.5 text-gray-300">
            <li><a href="#menu" class="hover:text-amber-400 transition-colors">Shop Micro-Lots</a></li>
            <li><a href="#origin" class="hover:text-amber-400 transition-colors">Our Mission</a></li>
            <li><a href="#awards" class="hover:text-amber-400 transition-colors">Recognition</a></li>
            <li><a href="#timeline" class="hover:text-amber-400 transition-colors">Seed to Cup</a></li>
            <li><a href="#booking" class="hover:text-amber-400 transition-colors">Tasting Room</a></li>
          </ul>
        </div>

        <!-- Locations -->
        <div>
          <h4 class="text-amber-400 font-bold uppercase tracking-widest mb-4">Locations</h4>
          <ul class="space-y-2.5 text-gray-300 font-sans text-xs">
            <li class="font-bold font-mono text-white">Turrialba Estate:</li>
            <li>KM 14 Volcán Turrialba Road</li>
            <li class="font-bold font-mono text-white mt-3">San José Lounge:</li>
            <li>Escazú Avenue, San José</li>
          </ul>
        </div>

        <!-- Contact & Newsletter -->
        <div>
          <h4 class="text-amber-400 font-bold uppercase tracking-widest mb-4">Contact</h4>
          <p class="text-gray-300 mb-2">WhatsApp: +506 8888 9999</p>
          <p class="text-gray-300 mb-4">concierge@coffeesecretturrialba.cr</p>
          <a
            href="#booking"
            class="inline-block px-4 py-2 bg-white text-black font-mono text-[11px] uppercase font-bold tracking-widest hover:bg-amber-400 transition-colors"
          >
            Inquire Reserve
          </a>
        </div>

      </div>

      <!-- Footer Bottom -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-gray-500 text-[11px]">
        <p>© {new Date().getFullYear()} Coffee Secret Turrialba. Inspired by GoodBoyBob Coffee aesthetic.</p>
        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
          <a href="#" class="hover:text-white transition-colors">Costa Rica Origin</a>
        </div>
      </div>

    </div>
  </footer>

  <WhatsAppButton />
</Layout>

<script>
  import { initAnimations } from '../scripts/animations.js';

  document.addEventListener('DOMContentLoaded', () => {
    initAnimations();
  });
</script>
